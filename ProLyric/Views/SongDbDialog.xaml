<Window x:Class="ProLyric.Views.SongDbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProLyric.ViewModels"
        Title="Song Database (SongDB)"
        Height="720" Width="980" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPitchBlack}"
        Foreground="{StaticResource BrushTextWhite}"
        FontFamily="{StaticResource FontUI}"
        FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Song list + Preview) -->
            <RowDefinition Height="*"/>
            <!-- Options (Language + Split mode) -->
            <RowDefinition Height="Auto"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & DB Path Picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="SongDB" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DATABASE" FontSize="9" FontWeight="Bold" Foreground="#888888"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtDbPath" Text="No SongDB selected" Foreground="#777777" VerticalAlignment="Center" 
                           FontFamily="{StaticResource FontMono}" FontSize="11" MaxWidth="380" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <Button x:Name="BtnChangeDb" Content="Change DB..." Click="OnChangeDbClick" Style="{StaticResource BtnTool}" Padding="12,4"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch" Height="36" VerticalContentAlignment="Center"
                     Background="#0A0A0A" Foreground="#FFFFFF" BorderBrush="#222222" BorderThickness="1"
                     Padding="12,0" TextChanged="OnSearchTextChanged" CaretBrush="#FFFFFF"/>
            <TextBlock IsHitTestVisible="False" Text="Search songs by title, lyric text, or song number (#)..."
                       VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#555555"
                       Visibility="{Binding Text, ElementName=TxtSearch, Converter={x:Static vm:EmptyStringToVisibilityConverter.Instance}}"/>

            <Button Grid.Column="1" Content="Search" Click="OnSearchClick"
                    Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0" Margin="8,0,0,0"/>
        </Grid>

        <!-- 3. Songs List & Lyrics Preview -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Songs List Column -->
                <ColumnDefinition Width="380" MinWidth="260"/>
                <!-- Spacer -->
                <ColumnDefinition Width="16"/>
                <!-- Preview Column -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Empty DB Notice Overlay -->
            <Border x:Name="BrdNoDbNotice" Grid.ColumnSpan="3" Background="#0C0C0C" BorderBrush="#222222" BorderThickness="1" CornerRadius="8"
                    Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="10" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No Song Database Connected" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Connect a SongDB database (.db, .sqlite, .xml) to search and import thousands of songs." Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,0,0,16"/>
                    <Button Content="+ Select SongDB File..." Click="OnChangeDbClick" Style="{StaticResource BtnPrimary}" Padding="20,8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Songs List -->
            <Border Grid.Column="0" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="6">
                <ListBox x:Name="LstSongs" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                         SelectionChanged="OnSongSelectionChanged" DisplayMemberPath="DisplayTitle"
                         FontFamily="{StaticResource FontMalayalam}" FontSize="13"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1C1C1C"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#141414"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Preview Panel -->
            <Border Grid.Column="2" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <TextBlock x:Name="TxtPreviewTitle" DockPanel.Dock="Top" Text="Select a song to preview" 
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                               FontFamily="{StaticResource FontMalayalam}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary (Malayalam) -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="PRIMARY (MALAYALAM)" FontWeight="Bold"
                                       Foreground="#666666" FontSize="10" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtPreviewPrimary" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#040404" Foreground="#FFFFFF"
                                     BorderBrush="#181818" BorderThickness="1" Padding="12"
                                     FontFamily="{StaticResource FontMalayalam}" FontSize="15"/>
                        </DockPanel>

                        <!-- Secondary (Manglish) -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="SECONDARY (MANGLISH)" FontWeight="Bold"
                                       Foreground="#666666" FontSize="10" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtPreviewSecondary" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#040404" Foreground="#D0D0D0"
                                     BorderBrush="#181818" BorderThickness="1" Padding="12"
                                     FontFamily="{StaticResource FontUI}" FontSize="14"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 4. Import Options: Language Choice and Split Mode -->
        <Border Grid.Row="3" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Language Options -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Language Mode:" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="CmbLanguage" Width="220" Height="32" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Both (Dual Lang)" IsSelected="True"/>
                        <ComboBoxItem Content="Primary Only (Malayalam)"/>
                        <ComboBoxItem Content="Secondary Only (Manglish)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Split Mode Options -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Split Stanzas:" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbParagraph" Content="By Paragraph (&lt;slide&gt; tags)" IsChecked="True" 
                                 Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"/>
                    <RadioButton x:Name="RbLineCount" Content="By Line Count:" 
                                 Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                    <TextBox x:Name="TxtLinesPerSlide" Text="4" Width="40" Height="26"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Background="#141414" Foreground="#FFFFFF" BorderBrush="#2E2E2E" BorderThickness="1"/>
                    <TextBlock Text="lines" Foreground="#777777" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource BtnSecondary}" Padding="20,8" Margin="0,0,10,0"/>
            <Button x:Name="BtnLoadSong" Content="Import into Editor" Click="OnLoadSongClick"
                    Style="{StaticResource BtnPrimary}" Padding="24,8"/>
        </StackPanel>
    </Grid>
</Window>
