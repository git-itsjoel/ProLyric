<Window x:Class="ProLyric.Views.LibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProLyric.ViewModels"
        Title="Saved Song Library"
        Height="640" Width="920" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPitchBlack}"
        Foreground="{StaticResource BrushTextWhite}"
        FontFamily="{StaticResource FontUI}"
        FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search -->
            <RowDefinition Height="Auto"/>
            <!-- Table -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="Song Library" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LOCAL SQLITE" FontSize="9" FontWeight="Bold" Foreground="#888888"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtSongCount" Text="0 songs saved" Foreground="#777777"
                       VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- 2. Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBox x:Name="TxtSearch" Height="36" VerticalContentAlignment="Center"
                     Background="#080808" Foreground="#FFFFFF" BorderBrush="#222222" BorderThickness="1"
                     Padding="12,0" FontFamily="{StaticResource FontUI}" FontSize="13"
                     CaretBrush="#FFFFFF" TextChanged="OnSearchTextChanged"/>

            <TextBlock IsHitTestVisible="False" Text="Search saved songs by title..." 
                       VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#555555"
                       FontFamily="{StaticResource FontUI}" FontSize="13"
                       Visibility="{Binding Text, ElementName=TxtSearch, Converter={x:Static vm:EmptyStringToVisibilityConverter.Instance}}"/>
        </Grid>

        <!-- 3. Songs DataGrid -->
        <Border Grid.Row="2" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18">
            <DataGrid x:Name="DgSongs" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                      RowBackground="#080808" AlternatingRowBackground="#0D0D0D"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#181818"
                      HeadersVisibility="Column" SelectionMode="Single"
                      FontFamily="{StaticResource FontUI}" FontSize="13"
                      SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#040404"/>
                        <Setter Property="Foreground" Value="#888888"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#222222"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="8"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="MODE" Binding="{Binding LanguageMode}" Width="90"/>
                    <DataGridTextColumn Header="EXPORTED .PRO FILE" Binding="{Binding ExportedFileName}" Width="2*"/>
                    <DataGridTextColumn Header="UPDATED" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Action Buttons -->
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="BtnDelete" Content="Delete" Click="OnDeleteClick"
                        Style="{StaticResource BtnTool}" Foreground="#FF6666" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="BtnDuplicate" Content="Duplicate" Click="OnDuplicateClick"
                        Style="{StaticResource BtnTool}" Padding="14,7"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Close" IsCancel="True" Style="{StaticResource BtnSecondary}" Padding="18,7" Margin="0,0,10,0"/>
                <Button x:Name="BtnOpen" Content="Open in Editor" Click="OnOpenClick"
                        Style="{StaticResource BtnPrimary}" Padding="22,7"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
