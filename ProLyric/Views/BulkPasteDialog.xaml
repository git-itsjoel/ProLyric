<Window x:Class="ProLyric.Views.BulkPasteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Paste Lyrics"
        Height="640" Width="880" MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPitchBlack}"
        Foreground="{StaticResource BrushTextWhite}"
        FontFamily="{StaticResource FontUI}"
        FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Editor TextBoxes -->
            <RowDefinition Height="*"/>
            <!-- Split Options -->
            <RowDefinition Height="Auto"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Bulk Paste Lyrics" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Paste raw lyrics below. Separate slides with blank lines or section tags like [Verse 1], [Chorus]."
                       Foreground="#777777" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. Editor Boxes -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" x:Name="Lang2Column"/>
            </Grid.ColumnDefinitions>

            <!-- Lang 1 Box (Malayalam Primary) -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="LANGUAGE 1 (MALAYALAM / PRIMARY)" 
                           FontWeight="Bold" Foreground="#888888" FontSize="10" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtLang1" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" Background="#060606" Foreground="#FFFFFF"
                         BorderBrush="#1E1E1E" BorderThickness="1" Padding="14"
                         FontFamily="{StaticResource FontMalayalam}" FontSize="15"
                         CaretBrush="#FFFFFF"/>
            </DockPanel>

            <!-- Column Splitter & Transliterate Divider -->
            <Grid Grid.Column="1" Margin="12,0" x:Name="DividerPanel" VerticalAlignment="Center">
                <Button Content="Auto-Transliterate ➔" 
                        Click="OnTransliterateClick"
                        Style="{StaticResource BtnTool}" Padding="10,14"
                        FontWeight="SemiBold" Foreground="#FFFFFF"
                        ToolTip="Phonetically transliterate Malayalam text in Lang 1 into Manglish in Lang 2"/>
            </Grid>

            <!-- Lang 2 Box (Manglish / Secondary) -->
            <DockPanel Grid.Column="2" x:Name="Lang2Panel">
                <TextBlock DockPanel.Dock="Top" Text="LANGUAGE 2 (MANGLISH / SECONDARY)" 
                           FontWeight="Bold" Foreground="#888888" FontSize="10" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtLang2" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" Background="#060606" Foreground="#E0E0E0"
                         BorderBrush="#1E1E1E" BorderThickness="1" Padding="14"
                         FontFamily="{StaticResource FontUI}" FontSize="14"
                         CaretBrush="#FFFFFF"/>
            </DockPanel>
        </Grid>

        <!-- 3. Split Mode Options -->
        <Border Grid.Row="2" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Split Stanzas:" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <RadioButton x:Name="RbParagraph" Content="By Paragraph (blank lines)" IsChecked="True" 
                             Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,20,0" Cursor="Hand"/>
                <RadioButton x:Name="RbLineCount" Content="By Line Count:" 
                             Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                <TextBox x:Name="TxtLinesPerSlide" Text="4" Width="42" Height="26"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Background="#141414" Foreground="#FFFFFF" BorderBrush="#2E2E2E" BorderThickness="1"/>
                <TextBlock Text="lines per slide" Foreground="#777777" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 4. Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource BtnSecondary}" Padding="18,7" Margin="0,0,10,0"/>
            <Button Content="Import Slides" Click="OnImportClick" Style="{StaticResource BtnPrimary}" Padding="22,7"/>
        </StackPanel>
    </Grid>
</Window>
